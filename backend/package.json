{
  "name": "backend",
  "scripts": {
    "dev": "bun --env-file=../.env run --hot src/index.ts",
    "db:push": "bun --env-file=../.env --bun drizzle-kit push",
    "db:migrate": "bun --env-file=../.env --bun drizzle-kit migrate",
    "db:studio": "bun --env-file=../.env --bun drizzle-kit studio",
    "admin:create": "bun --env-file=../.env run src/scripts/create-admin.ts",
    "db:seed": "bun --env-file=../.env run src/scripts/seed.ts"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "@hono/swagger-ui": "^0.6.1",
    "@valibot/to-json-schema": "^1.8.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.13.9",
    "hono-openapi": "^1.3.3",
    "nanoid": "^6.0.1",
    "shared": "workspace:*",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^1.0.0-rc.4"
  }
}
